# spartan-partner-onboarding — Lambda environment variables.
#
# These are the six variables index.js reads. Nothing in the code hardcodes a
# bucket, sender, recipient, origin, or webhook URL; an unset REQUIRED variable
# is a misconfiguration, not a fallback. Set them on the Lambda function's
# Configuration -> Environment variables tab. This file is a template only and is never read at
# runtime (there is no dotenv dependency).

# --- Required ---

# Destination bucket for the stored submission. Region is pinned to us-east-2
# in storage.js, NOT taken from here. If this is unset the handler logs and
# returns 500 rather than reporting a success it cannot back up.
SUBMISSIONS_BUCKET=spartan-capital-partner-submissions

# Verified SES sender. The identity must be verified in us-east-1, which is the
# region notify.js pins.
SES_FROM=notifications@spartancapitalgroup.com

# Notification recipients. Comma-separated; whitespace and a trailing comma are
# tolerated.
NOTIFY_TO=cvalero@spartancapitalgroup.com,frank@spartancapitalgroup.com

# Origin(s) permitted to call the Function URL from a browser. Comma-separated
# for more than one. When unset, no Access-Control-Allow-Origin is returned and
# browser submissions are blocked — safe, but it will look like the form is
# broken, so the handler logs a warning.
#
# MUST match wherever the onboarding page is actually served from. The page is a
# standalone HTML file on S3/CloudFront, NOT part of the Next.js site, so this is
# not the marketing domain. If this value and the page's real origin disagree,
# EVERY submission fails CORS before it reaches the handler — the browser blocks
# it, so there is no log line and no stored packet to find afterwards. Confirm
# the live origin before launch.
ALLOWED_ORIGIN=https://apply.spartancapitalgroup.com

# --- Optional ---

# Power Automate HTTP-trigger URL for the SharePoint document library. When
# unset or empty the relay is skipped silently — that is a supported
# configuration, not an error. A failure of the flow never fails the request.
# Leave commented out until the flow exists.
# SHAREPOINT_FLOW_URL=https://prod-00.westus.logic.azure.com:443/workflows/...

# Google Sheets append. The /exec URL of the deployed Apps Script web app that
# owns the onboarding spreadsheet — the same no-auth JSON-POST arrangement the
# Python spartan-lead-handler uses, so there is no service account and no
# googleapis client here. sheets.js POSTs { headers: [...], values: [...] } to
# it and follows the 302 Apps Script answers with.
#
# When unset or empty the append is skipped silently, exactly like the
# SharePoint relay. A failure never fails the request and never changes the
# status code: the sheet is a convenience copy, S3 is the durable record. A
# failure logs
#   spartan-partner-onboarding: sheets append failed, submission IS saved
# with the submission id, so a missing row is traceable in CloudWatch.
#
# PLACEHOLDER — replace with the real deployment URL at provisioning. The script
# must be deployed as "Execute as: Me" and "Who has access: Anyone", or the POST
# gets an HTML sign-in page instead of a 200.
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
